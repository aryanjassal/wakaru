{
  "name": "wakaru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dictionary": "tsx scripts/build-dictionary.ts",
    "push:dictionary-schema": "drizzle-kit push --force --config drizzle.config.ts",
    "start:tui": "node --experimental-ffi dist/main.js",
    "dev:tui": "node --experimental-ffi --import tsx src/tui/main.tsx",
    "watch:tui": "node --experimental-ffi --watch --import tsx src/tui/main.tsx",
    "build": "node --import tsx scripts/build.ts",
    "package:runtime": "npm run build && npm install --prefix dist --omit=dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "kuromoji": "^0.1.2",
    "react": "^19.2.7",
    "saxes": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=26.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true,
    "unrs-resolver@1.12.2": true
  }
}
